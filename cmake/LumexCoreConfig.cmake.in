@PACKAGE_INIT@

# LumexCore CMake Configuration
# This file is generated by CMake during installation

include(CMakeFindDependencyMacro)

# Include the exported targets for LumexCore components
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LumexCoreTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/LumexCoreTargets.cmake")
endif()

# Include the exported targets for LumexApplied components
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/LumexAppliedTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/LumexAppliedTargets.cmake")
endif()

# Create the aggregate target if it doesn't exist
if(NOT TARGET Lumex::Lumex)
    add_library(Lumex::Lumex INTERFACE IMPORTED)
    
    # Core components
    set(_lumex_core_components 
        Lumex::environment
        Lumex::exceptions
        Lumex::filesystem
        Lumex::optional
        Lumex::string
        Lumex::string_view
        Lumex::time
        Lumex::utility
    )
    
    # Applied components
    set(_lumex_applied_components
        Lumex::hardware
        Lumex::logging
        Lumex::settings
        Lumex::temporary
    )
    
    # Link all components
    set_target_properties(Lumex::Lumex PROPERTIES
        INTERFACE_LINK_LIBRARIES "${_lumex_core_components};${_lumex_applied_components}"
    )
endif()

check_required_components(LumexCore)
