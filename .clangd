If:
  PathMatch: .*\.(h|hpp|c|cpp|ipp|cuh|cu)
CompileFlags:
  Compiler: clang-cl
  Add:
  # C++ Standard and Warning Flags
  - /std:c++11
  - /W4
  - /permissive-
  - /EHsc

  # Preprocessor Defines
  - -D_WIN32
  - -D_WIN64

  # Project include path (relative to .clangd location)
  - -ID:/Develop/LumexCore
  - -ID:/local/msys64/mingw64/include/gtest

# Indexing configuration
Index:
  Background: Skip
  StandardLibrary: Yes

# Diagnostics configuration  
Diagnostics:
  Suppress:
  - "readability-convert-member-functions-to-static"
  - "modernize-use-trailing-return-type"
  - "readability-braces-around-statements"
  - "readability-container-data-pointer"
  # Enable clang-tidy checks
  ClangTidy:
    Add:
    - readability-*
    - performance-*
    - modernize-*
    - bugprone-*
    - cppcoreguidelines-*
    - performance-*
    - misc-*
    - portability-*
    - concurrency-*

# InlayHints configuration
InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
